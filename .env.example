# Tailscale API client: policy_file:read, devices:core:read (add policy_file to enable set_policy)
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# Node-registration client: auth_keys scope, tagged tag:tailscale-admin-mcp
TS_CLIENT_SECRET=
# Who may call the MCP: at least one is required
ALLOWED_LOGINS=you@example.com
ALLOWED_TAGS=
